# StoreQL — example environment. Copy to .env and adjust. NEVER commit .env.
# Secrets (DB passwords, JWT keys, payment keys) live here / in your secret store — not in code or images.

# --- Postgres (one DB; each service uses its own schema + its own role — see
# infra/postgres-init-roles.sql) ---
# POSTGRES_USER/PASSWORD remain the bootstrap/admin role (runs the role-provisioning
# script, owns ops/backup access). No business service connects as this role.
POSTGRES_DB=storeql
POSTGRES_USER=storeql
POSTGRES_PASSWORD=storeql_dev_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backups (docs/BACKUP-AND-RESTORE.md). The backup service dumps the database every day at
# STOREQL_BACKUP_AT (UTC) with a manifest of every table's count, keeps the newest STOREQL_BACKUP_KEEP,
# takes a base backup every STOREQL_BACKUP_BASE_EVERY_DAYS for point-in-time recovery over the WAL
# Postgres archives (every PG_ARCHIVE_TIMEOUT seconds at most: the data at risk), and encrypts each
# dump to STOREQL_BACKUP_RECIPIENT — an age public key (`docker compose run --rm backup age-keygen`
# prints a pair; keep the identity line OFF this machine, it is what reads the backups back).
# Empty means UNENCRYPTED backups, said aloud in the log; never leave it empty with real data.
STOREQL_BACKUP_RECIPIENT=
STOREQL_BACKUP_AT=02:30
STOREQL_BACKUP_KEEP=14
STOREQL_BACKUP_KEEP_BASE=4
STOREQL_BACKUP_BASE_EVERY_DAYS=7
PG_ARCHIVE_TIMEOUT=300

# --- Per-service Postgres roles (infra/postgres-init-roles.sql GRANTs each role only
# its own schema). Changing a password here also means updating: the matching line in
# infra/postgres-init-roles.sql, the matching line in infra/pgbouncer-userlist.txt, and
# re-running the roles script against the live DB (see header comment in that file).
IAM_DB_PASSWORD=iam_dev_change_me
TENANT_DB_PASSWORD=tenant_dev_change_me
PRODUCT_DB_PASSWORD=product_dev_change_me
INVENTORY_DB_PASSWORD=inventory_dev_change_me
PURCHASE_DB_PASSWORD=purchase_dev_change_me

# ── Purchase-order spend authority ───────────────────────────────────────────
# CURRENCY:ROLE:amount, comma-separated. UNLIMITED is accepted in place of a
# number. Empty leaves approval OFF: any staff role may submit any amount, which
# is how the service behaved before the feature existed.
#
# Per CURRENCY as well as per role, and that is the design rather than a detail.
# There is no FX handling in StoreQL, so a ceiling of 5000 is roughly GBP 25
# against the yen and roughly GBP 13,000 against the dinar — one number reused
# across currencies either blocks every overseas order or grants a hundred times
# the intended authority. Once ANY limit is configured, a currency with no entry
# fails closed, so enabling sterling does not leave a hole shaped like the first
# order from a new market.
# PURCHASE_APPROVAL_LIMITS=GBP:STOREKEEPER:500,GBP:MANAGER:5000,GBP:OWNER:UNLIMITED,INR:STOREKEEPER:50000,INR:MANAGER:500000,INR:OWNER:UNLIMITED,JPY:MANAGER:800000,EUR:STOREKEEPER:500,EUR:MANAGER:5000,EUR:OWNER:UNLIMITED
PURCHASE_APPROVAL_LIMITS=

# Browser origins allowed to call the gateway (comma-separated). Unset uses the web UI on this
# machine (http://localhost:8088, http://localhost:40015 and their 127.0.0.1 forms). For
# phone/tablet testing over Wi-Fi add the LAN origin, e.g. http://192.168.1.20:8088. Never "*".
# GATEWAY_CORS_ALLOWED_ORIGINS=http://localhost:8088,http://192.168.1.20:8088

# ── Host port publishes (local tooling only) ─────────────────────────────────
# Every service reaches these over the compose network by name, so changing a
# host port cannot affect the stack. Override when another Compose project on the
# same machine already holds one: a foreign container binding 0.0.0.0:PORT blocks
# even the loopback bind used here, which has taken this stack down before.
# KAFKA_HOST_PORT=9092
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# KAFKA_UI_PORT=8081
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3100
PRICING_DB_PASSWORD=pricing_dev_change_me
CART_DB_PASSWORD=cart_dev_change_me
ORDER_DB_PASSWORD=order_dev_change_me
PAYMENT_DB_PASSWORD=payment_dev_change_me
CUSTOMER_DB_PASSWORD=customer_dev_change_me
NOTIFICATION_DB_PASSWORD=notification_dev_change_me
REPORTING_DB_PASSWORD=reporting_dev_change_me

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Consul (service discovery) ---
CONSUL_HOST=localhost
CONSUL_PORT=8500

# --- Config service ---
CONFIG_SERVER_URL=http://localhost:8888
# Shared token — every service sends this in X-Config-Token when calling config-svc.
# Must be >= 32 chars. Generate with: openssl rand -base64 48
STOREQL_CONFIG_TOKEN=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_change_me

# --- Tracing ---
ZIPKIN_URL=http://localhost:9411/api/v2/spans

# --- Tokens (20.15) ---
# Access tokens are RS256, signed by iam-svc with a rotating key whose public half it publishes at
# /auth/.well-known/jwks.json; the gateway and the MQTT broker verify against that and hold no
# secret. STOREQL_JWT_SECRET is given to iam-svc alone: it seals the signing keys' private halves
# in its database. It signs nothing — but change it and the stored keys can no longer be opened.
# REQUIRED to be >= 32 characters — iam-svc refuses to start otherwise.
# Generate your own (never commit it):  openssl rand -base64 48
JWT_ISSUER=storeql
STOREQL_JWT_SECRET=

# --- Webhooks (22.6) ---
# Each webhook endpoint a business registers has a signing secret, shown to it once and kept
# sealed in notification-svc's database under this key (16, 24 or 32 bytes, base64). Change it and
# the stored secrets can no longer be opened — every endpoint's secret would have to be rotated.
# docker-compose falls back to a development key; production must set its own:
#   openssl rand -base64 32
STOREQL_WEBHOOKS_SECRETS_KEY=

# Accounting connectors (17.9): the key the tokens a business's accounting package issued — Xero,
# QuickBooks Online, Sage — are sealed under in purchase-svc. Same shape and the same warning as the
# webhooks key: lose it and every business connects its package again.
#   openssl rand -base64 32
STOREQL_ACCOUNTING_SECRETS_KEY=

# The MQTT broker's one password user: notification-svc's publisher connection. REQUIRED — no
# default. Letters and digits only (it is written into a CSV the broker reads at first boot).
# Generate your own:  openssl rand -hex 24
MQTT_PUBLISHER_PASSWORD=

# --- Email (notification-svc) ---
# The dev stack emails through the Mailpit catcher (read it at http://localhost:8025). A password
# reset goes by email only, so a deployment without email cannot deliver one. Point these at your
# own mail service (and add storeql.notification.smtp.username/password as secrets) outside dev.
# NOTIFICATION_CHANNEL=email
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_STARTTLS=false
# NOTIFICATION_FROM=no-reply@storeql.local
# MAILPIT_UI_PORT=8025

# --- Platform admin bootstrap (one-shot; the bootstrap endpoint 409s once an admin exists) ---
# REQUIRED — no default. A known default password would mean every fresh deploy ships
# with a publicly-known PLATFORM_ADMIN superuser credential. Generate your own:
# openssl rand -base64 24
PLATFORM_ADMIN_EMAIL=admin@storeql.dev
PLATFORM_ADMIN_PASSWORD=
# The platform administrator's authenticator secret, base 32, at least 128 bits (20.12). REQUIRED:
# the account is created with its second factor, and every sign-in asks for a code from it. Put
# the same secret into an authenticator app (any TOTP app: SHA-1, 6 digits, 30 seconds) —
# scripts/platform-code.sh --setup prints the key and an otpauth:// link for it, and on a local
# stack with no app at hand scripts/platform-code.sh prints the current code.
# Generate your own:  head -c 20 /dev/urandom | base32 | tr -d '='
PLATFORM_ADMIN_TOTP_SECRET=

# --- Vulnerability disclosure: /.well-known/security.txt (RFC 9116) ---
# Published by the gateway (and forwarded by the web container) only when CONTACT and EXPIRES are both
# set; otherwise the file answers 404, so no deployment ever serves an invented contact. CONTACT is
# one or more comma-separated mailto:, https: or tel: URIs. EXPIRES is an ISO-8601 instant in the
# future and no more than a year ahead — renew it before it lapses, or the file stops being served.
# POLICY, CANONICAL (https URLs) and PREFERRED_LANGUAGES (e.g. en, de) are optional.
SECURITY_TXT_CONTACT=
SECURITY_TXT_EXPIRES=
SECURITY_TXT_POLICY=
SECURITY_TXT_CANONICAL=
SECURITY_TXT_PREFERRED_LANGUAGES=

# --- Server-side pricing (gap #63) ---
# When true, order-svc resolves unit prices (and tax) from pricing-svc and ignores
# client-supplied prices/tax/discount. Defaults to true (secure) — a client that can
# name its own price is a direct fraud vector, tenant scoping aside. Set to false only
# for local dev/demo with an unseeded price catalogue; order-svc logs a WARNING at
# startup whenever this is false as a reminder. Production MUST be true.
STOREQL_ORDER_PRICING_ENFORCE=true

# --- JVM heap caps (applied via JAVA_TOOL_OPTIONS / KAFKA_HEAP_OPTS) ---
# Defaults below target an 8 vCPU / 16 GB VPS.
# For 8 GB VPS (minimum): halve Xmx values, set Kafka to -Xms256m -Xmx512m.
# For 32 GB VPS (full load): double Xmx values, set Kafka to -Xms1g -Xmx2g.
GATEWAY_JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC
CONFIG_JAVA_OPTS=-Xms64m -Xmx256m -XX:+UseG1GC
IAM_JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC
TENANT_JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC
INVENTORY_JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC
PRODUCT_JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC
ORDER_JAVA_OPTS=-Xms128m -Xmx512m -XX:+UseG1GC
PURCHASE_JAVA_OPTS=-Xms128m -Xmx384m -XX:+UseG1GC
PRICING_JAVA_OPTS=-Xms128m -Xmx384m -XX:+UseG1GC
KAFKA_HEAP_OPTS=-Xms512m -Xmx1g
ZIPKIN_JAVA_OPTS=-Xms128m -Xmx512m
KAFKA_UI_JAVA_OPTS=-Xms128m -Xmx384m

# --- Logging ---
# Application log level for com.storeql, applied at startup by LogLevelConfigurer. Takes effect on
# restart, no rebuild. Everything logged here is formatted, shipped over OTLP and stored, so across
# 14 services the cost of FINE is paid three times over — keep INFO unless actively debugging.
# JUL names (SEVERE/WARNING/INFO/CONFIG/FINE/FINER/FINEST/ALL/OFF) and the usual aliases
# (ERROR/WARN/DEBUG/TRACE) both work. Per-service override: set it on that service only.
STOREQL_LOG_LEVEL=INFO

# --- Docker memory hard limits (enforced via mem_limit; prevents OOM-killing the host) ---
# This file lists the tunable subset; several services take their mem_limit default straight from
# docker-compose.yml and are not repeated here. Summed across ALL capped containers the ceiling is
# ~12.6 GB, leaving ~3.4 GB on a 16 GB host for the OS and for postgres, which is deliberately
# uncapped (it manages its own shared_buffers/work_mem — see the PG tuning block below).
GATEWAY_MEM_LIMIT=700m
CONFIG_MEM_LIMIT=384m
IAM_MEM_LIMIT=700m
TENANT_MEM_LIMIT=700m
INVENTORY_MEM_LIMIT=700m
PRODUCT_MEM_LIMIT=700m
ORDER_MEM_LIMIT=700m
PURCHASE_MEM_LIMIT=512m
PRICING_MEM_LIMIT=512m
KAFKA_MEM_LIMIT=1300m
KAFKA_UI_MEM_LIMIT=550m
ZIPKIN_MEM_LIMIT=700m
PROMETHEUS_MEM_LIMIT=512m
LOKI_MEM_LIMIT=512m
TEMPO_MEM_LIMIT=512m
# Raising this? Raise memory_limiter.limit_mib (~80% of it) and GOMEMLIMIT in
# infra/otel-collector-config.yaml and docker-compose.yml to match, or the container gets
# OOM-killed before the collector can shed load.
OTEL_COLLECTOR_MEM_LIMIT=512m

# --- PostgreSQL tuning (override defaults in docker-compose command section) ---
# For 16 GB VPS recommended values:
# PG_SHARED_BUFFERS=2GB          (25% of RAM)
# PG_EFFECTIVE_CACHE_SIZE=8GB    (50% of RAM)
# PG_WORK_MEM=32MB
# PG_MAINTENANCE_WORK_MEM=256MB
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=8GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=256MB

# --- Production domain (storeql.com) ----------------------------------------
# Used by docker-compose.prod.yml and the GitHub Actions docker-publish workflow.
#
# 1. DNS — add these A records at your registrar before first deploy:
#      app.storeql.com  →  <your-server-public-ip>
#      api.storeql.com  →  <your-server-public-ip>
#      storeql.com      →  <your-server-public-ip>
#
# 2. Caddy (infra/Caddyfile) handles TLS automatically via Let's Encrypt.
#    Set this email so Let's Encrypt can notify you about cert expiry:
CADDY_ACME_EMAIL=ops@storeql.com
#
# 3. Set the gateway URL as a GitHub Actions repository variable
#    (Settings → Secrets and variables → Actions → Variables):
#      STOREQL_API_BASE = https://api.storeql.com/api
#    This is baked into the Flutter web bundle at CI build time.
#
# 4. Start the production stack:
#    docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

# --- Toolchain note ---
# Build with JDK 21:  export JAVA_HOME=/usr/lib/jvm/temurin-21-jdk-amd64

# Compose project name. Pinned so volume/network prefixes do not depend on the
# directory name (StoreQL rename, 2026-09-20).
COMPOSE_PROJECT_NAME=storeql
