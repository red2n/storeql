<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      StoreQL — parent reactor POM (monorepo).
      Aggregates all modules: shared contracts, platform services, business services.
      Build with JDK 21:  JAVA_HOME=/usr/lib/jvm/temurin-21-jdk-amd64 mvn clean install
    -->

    <!-- Helidon application parent: gives us the Helidon dependency BOM + sane plugin config. -->
    <parent>
        <groupId>io.helidon.applications</groupId>
        <artifactId>helidon-mp</artifactId>
        <version>4.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.storeql</groupId>
    <artifactId>storeql-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>StoreQL Parent</name>
    <description>Multi-tenant stock &amp; store management platform — Helidon MP microservices</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <graalvm.native.maven.plugin.version>0.9.24</graalvm.native.maven.plugin.version>

        <!-- Versions for libraries NOT managed by the Helidon BOM -->
        <flyway.version>13.7.0</flyway.version>
        <postgresql.version>42.7.13</postgresql.version>
        <hikaricp.version>7.1.0</hikaricp.version>
        <!-- Must match the version Helidon's own BOM pins org.testcontainers:testcontainers/jdbc
             to (checked via `mvn help:effective-pom`) — otherwise postgresql/kafka/database-commons
             resolve to this property's value while testcontainers-core/jdbc resolve to Helidon's,
             producing a mixed-version Testcontainers classpath (unsupported; caused flaky
             GenericContainer port-wait timeouts against containers that were demonstrably up). -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <junit.version>5.11.3</junit.version>
        <lettuce.version>6.5.1.RELEASE</lettuce.version>
        <pdfbox.version>3.0.8</pdfbox.version>
        <verapdf.version>1.30.2</verapdf.version>
        <storeql.version>0.1.0-SNAPSHOT</storeql.version>

        <!-- Security overrides (22.11). Versions the Helidon 4.4.1 parent manages that carry a known
             vulnerability with a fix, raised here through Helidon's own version properties so every
             artifact of the family moves together. Each line names what it closes; drop a line when
             the Helidon parent has caught up (the vulnerability scan says when it no longer matters).
             kafka-clients needs no line: Helidon manages 3.9.2 — the modules used to pin 3.7.1
             themselves (GHSA-5qcv-4rpc-jp93) and no longer do. -->
        <!-- GHSA-c4c3-7fpv-j4q5 (critical), GHSA-3qp7-7mw8-wx86, GHSA-c653-97m9-rcg9,
             GHSA-x4gw-5cx5-pgmh, GHSA-558v-64gr-wgg4, GHSA-mj4r-2hfc-f8p6 — via lettuce, hivemq -->
        <version.lib.netty>4.1.137.Final</version.lib.netty>
        <!-- GHSA-r7wm-3cxj-wff9, GHSA-j3rv-43j4-c7qm, GHSA-rmj7-2vxq-3g9f (high; fixed 2.21.4) and
             GHSA-5gvw-p9qm-jgwh, GHSA-5jmj-h7xm-6q6v, GHSA-mhm7-754m-9p8w (medium; fixed 2.21.5)
             — via java-jwt, kafka -->
        <version.lib.jackson>2.21.5</version.lib.jackson>
        <!-- GHSA-g3pr-3p32-fp23, GHSA-w737-wx49-qj23 — via Helidon metrics -->
        <version.lib.micrometer>1.15.12</version.lib.micrometer>
        <version.lib.micrometer-prometheus>1.15.12</version.lib.micrometer-prometheus>
        <!-- GHSA-xx22-p4ch-683r — kafka-clients 3.9.2 brings the maintained fork at 1.10.1 -->
        <lz4-java.version>1.11.3</lz4-java.version>
        <!-- GHSA-rcgg-9c38-7xpx: unbounded memory from a W3C baggage header, and the gateway reads
             headers from the internet -->
        <version.lib.opentelemetry>1.62.0</version.lib.opentelemetry>
        <version.lib.opentelemetry-sdk-extension-autoconfigure>1.62.0</version.lib.opentelemetry-sdk-extension-autoconfigure>
        <version.lib.opentelemetry.opentracing.shim>1.62.0</version.lib.opentelemetry.opentracing.shim>

        <!-- Google's phone number metadata (customer-svc reads a phone in the business's own
             country and keeps it in E.164). No advisory; raise it with the metadata releases. -->
        <libphonenumber.version>9.0.32</libphonenumber.version>

        <!-- Quality tooling versions -->
        <archunit.version>1.5.0</archunit.version>
        <spotbugs-plugin.version>4.10.4.1</spotbugs-plugin.version>
        <pmd-plugin.version>3.28.0</pmd-plugin.version>
        <fmt-plugin.version>2.29</fmt-plugin.version>
        <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
        <checkstyle.version>14.1.0</checkstyle.version>
        <cyclonedx-plugin.version>2.9.3</cyclonedx-plugin.version>

        <!-- Quality gate skip flags (override per-module or on CLI with -Dspotbugs.skip=true etc.) -->
        <spotbugs.skip>false</spotbugs.skip>
        <pmd.skip>false</pmd.skip>
        <checkstyle.skip>false</checkstyle.skip>
        <!-- false surveys every module in one run instead of stopping at the first -->
        <checkstyle.failsOnError>true</checkstyle.failsOnError>
        <maven.fmt.skip>false</maven.fmt.skip>
    </properties>

    <modules>
        <!-- shared CONTRACTS only — no business logic -->
        <module>shared/common-ids</module>
        <module>shared/events-contract</module>
        <module>shared/common-web</module>
        <module>shared/common-test</module>
        <module>platform/discovery</module>
        <module>shared/common-service</module>
        <module>shared/einvoice</module>
        <module>shared/gs1</module>
        <module>services/iam-svc</module>
        <module>services/tenant-svc</module>
        <module>services/product-svc</module>
        <module>services/inventory-svc</module>
        <module>services/order-svc</module>
        <module>services/cart-svc</module>
        <module>services/pricing-svc</module>
        <module>services/payment-svc</module>
        <module>services/purchase-svc</module>
        <module>services/customer-svc</module>
        <module>services/notification-svc</module>
        <module>services/reporting-svc</module>
        <module>platform/config</module>
        <module>platform/gateway</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Our own shared modules, version-managed here so children just declare the artifact -->
            <dependency>
                <groupId>com.storeql</groupId>
                <artifactId>common-ids</artifactId>
                <version>${storeql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.storeql</groupId>
                <artifactId>events-contract</artifactId>
                <version>${storeql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.storeql</groupId>
                <artifactId>common-web</artifactId>
                <version>${storeql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.storeql</groupId>
                <artifactId>common-test</artifactId>
                <version>${storeql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.storeql</groupId>
                <artifactId>common-service</artifactId>
                <version>${storeql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.storeql</groupId>
                <artifactId>einvoice</artifactId>
                <version>${storeql.version}</version>
            </dependency>

            <!-- E-invoices: Factur-X PDF/A-3 (pdfbox), and the reference PDF/A validator for its tests -->
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.verapdf</groupId>
                <artifactId>validation-model-jakarta</artifactId>
                <version>${verapdf.version}</version>
            </dependency>

            <!-- Security override (22.11): see the properties above -->
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>${lz4-java.version}</version>
            </dependency>

            <!-- Persistence / migrations (not in Helidon BOM) -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikaricp.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>

            <!-- Redis client (gateway: distributed rate-limit + brute-force counters) -->
            <dependency>
                <groupId>io.lettuce</groupId>
                <artifactId>lettuce-core</artifactId>
                <version>${lettuce.version}</version>
            </dependency>

            <!-- Testing -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Phone numbers in E.164, read in the business's own country (customer-svc) -->
            <dependency>
                <groupId>com.googlecode.libphonenumber</groupId>
                <artifactId>libphonenumber</artifactId>
                <version>${libphonenumber.version}</version>
            </dependency>

            <!-- MicroProfile Fault Tolerance — retry, circuit-breaker, timeout on sync clients -->
            <dependency>
                <groupId>io.helidon.microprofile</groupId>
                <artifactId>helidon-microprofile-fault-tolerance</artifactId>
                <version>4.5.5</version>
            </dependency>

            <!-- Quality: ArchUnit — architecture rule tests (used in common-test + each service) -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
                <scope>compile</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Helidon/CDI play nicer with classloader isolation off for tests -->
                        <useModulePath>false</useModulePath>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                </plugin>

                <!-- ── google-java-format ─────────────────────────────────────────────
                     Run `mvn fmt:format` to auto-fix. `mvn fmt:check` (or verify phase)
                     fails the build if any file diverges from canonical format.        -->
                <plugin>
                    <groupId>com.spotify.fmt</groupId>
                    <artifactId>fmt-maven-plugin</artifactId>
                    <version>${fmt-plugin.version}</version>
                    <configuration>
                        <skip>${maven.fmt.skip}</skip>
                    </configuration>
                </plugin>

                <!-- ── SpotBugs ──────────────────────────────────────────────────────
                     Detects likely bugs: null-dereference, resource leaks, bad JDBC use.
                     CDI false-positives are suppressed via spotbugs-exclude.xml.        -->
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-plugin.version}</version>
                    <configuration>
                        <effort>Max</effort>
                        <threshold>Medium</threshold>
                        <failOnError>true</failOnError>
                        <skip>${spotbugs.skip}</skip>
                        <excludeFilterFile>${maven.multiModuleProjectDirectory}/config/spotbugs-exclude.xml</excludeFilterFile>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.graalvm.buildtools</groupId>
                    <artifactId>native-maven-plugin</artifactId>
                    <version>${graalvm.native.maven.plugin.version}</version>
                </plugin>

                <!-- ── SBOM (22.10) ──────────────────────────────────────────────────
                     One CycloneDX bill of materials for the whole reactor: every module and every
                     dependency that ships (compile + runtime; test and provided scopes are not in
                     an image). Not bound to a phase — the release workflow and
                     scripts/sbom.sh run `cyclonedx:makeAggregateBom`; the version and the shape
                     are pinned here so both produce the same document.                  -->
                <plugin>
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>${cyclonedx-plugin.version}</version>
                    <configuration>
                        <projectType>application</projectType>
                        <schemaVersion>1.6</schemaVersion>
                        <outputFormat>all</outputFormat>
                        <outputName>storeql-bom</outputName>
                        <includeCompileScope>true</includeCompileScope>
                        <includeRuntimeScope>true</includeRuntimeScope>
                        <includeProvidedScope>false</includeProvidedScope>
                        <includeSystemScope>false</includeSystemScope>
                        <includeTestScope>false</includeTestScope>
                        <includeLicenseText>false</includeLicenseText>
                        <!-- common-test is the reactor's test-helper module (JUnit, Testcontainers,
                             ArchUnit at compile scope, because helpers are its product). Services
                             depend on it at test scope only and no image contains it, so it is
                             not part of what ships. -->
                        <excludeArtifactId>common-test</excludeArtifactId>
                    </configuration>
                </plugin>

                <!-- ── PMD ───────────────────────────────────────────────────────────
                     Flags error-prone patterns and dead code. Ruleset in config/pmd-ruleset.xml
                     excludes noisy CDI/framework false-positives.                      -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${checkstyle-plugin.version}</version>
                    <dependencies>
                        <!-- The plugin's own Checkstyle is years behind; pin the current one. -->
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>${checkstyle.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle.xml</configLocation>
                        <propertyExpansion>config_loc=${maven.multiModuleProjectDirectory}/config</propertyExpansion>
                        <includeTestSourceDirectory>true</includeTestSourceDirectory>
                        <consoleOutput>true</consoleOutput>
                        <failsOnError>${checkstyle.failsOnError}</failsOnError>
                        <violationSeverity>error</violationSeverity>
                        <skip>${checkstyle.skip}</skip>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${pmd-plugin.version}</version>
                    <configuration>
                        <rulesets>
                            <ruleset>${maven.multiModuleProjectDirectory}/config/pmd-ruleset.xml</ruleset>
                        </rulesets>
                        <failOnViolation>true</failOnViolation>
                        <printFailingErrors>true</printFailingErrors>
                        <targetJdk>21</targetJdk>
                        <skip>${pmd.skip}</skip>
                        <excludeRoots>
                            <excludeRoot>target/generated-sources</excludeRoot>
                        </excludeRoots>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- fmt:check runs at validate (first phase) — fastest possible feedback on format violations -->
            <plugin>
                <groupId>com.spotify.fmt</groupId>
                <artifactId>fmt-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>format-check</id>
                        <phase>validate</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Checkstyle runs at validate too, right after the formatter: names, imports and shapes
                 a formatter cannot decide (config/checkstyle.xml), before anything is compiled -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <executions>
                    <execution>
                        <id>checkstyle-check</id>
                        <phase>validate</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- SpotBugs runs at verify (after compile + test) -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- PMD runs at verify -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <executions>
                    <execution>
                        <id>pmd-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
