<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter for StoreQL.

  Suppresses false positives that arise from CDI/Jakarta EE patterns that SpotBugs
  cannot reason about statically (injection, proxy subclassing, lifecycle callbacks).
  Only add entries here when the finding is a confirmed false positive — never suppress
  real bugs.
-->
<FindBugsFilter>

    <!--
      CDI-injected fields are never set by a constructor, so SpotBugs flags them as
      "field is never written" or "may not be initialized". The CDI container writes
      them at runtime via proxying.
    -->
    <Match>
        <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
        <Or>
            <Annotation name="jakarta.inject.Inject"/>
            <Annotation name="jakarta.enterprise.inject.Inject"/>
        </Or>
    </Match>

    <!--
      Java records expose their component accessor methods, which return the internal
      field reference directly. For immutable value types (records) this is intentional —
      the record IS the value; exposing its fields is correct. Covers dto, domain, and
      lightweight value records nested inside service classes.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~.*\.(dto|domain|service)\..*"/>
    </Match>

    <!--
      Gs1Scan is the reading taken from a scanned code: a record in shared/gs1, outside the
      dto/domain/service packages the rule above covers. Its elements map is BOTH defensively
      copied in the canonical constructor AND wrapped unmodifiable, so the accessor cannot hand
      out anything a caller could change — a stronger guarantee than the records already exempted.
      SpotBugs does not see through Collections.unmodifiableMap and flags the field return anyway.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="com.storeql.gs1.Gs1Scan"/>
    </Match>

    <!--
      ReserveOutcome/ReserveBatchItem are lightweight, immutable-by-convention records nested
      inside InventoryRepository for the reserveBatch(...) batch-reservation result/input — the
      same record-accessor pattern already exempted for dto/domain/service records above, just
      declared in a repo class instead of one of those packages.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~com\.storeql\.inventory\.repo\.InventoryRepository\$(ReserveOutcome|ReserveBatchItem)"/>
    </Match>

    <!--
      Fulfilment is what one handover did (wave picking): a record nested in OrderRepository whose
      lines are replaced by List.copyOf(...) in its compact constructor, so the accessor returns an
      immutable list — the same pattern as the einvoice model above, in a repo class.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="com.storeql.order.repo.OrderRepository$Fulfilment"/>
    </Match>

    <!--
      The EN 16931 model (07.13/18.9) is a tree of records in shared/einvoice, outside the
      dto/domain/service packages matched above. Every List component is replaced in the record's
      compact constructor by List.copyOf(...) (or List.of() when absent), so an accessor returns an
      immutable list; SpotBugs cannot see through the constructor's helper to prove it.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
        <Class name="~com\.storeql\.einvoice\.Invoice(\$.*)?"/>
    </Match>

    <!--
      aggregateDemand builds a PreparedStatement SQL string dynamically to embed a
      date_trunc literal (day/week/month). The literal is validated upstream against
      an allow-list (DAY|WEEK|MONTH) before reaching this method, so there is no SQL
      injection risk. SpotBugs cannot trace the call-site validation.
    -->
    <Match>
        <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
        <Class name="com.storeql.inventory.repo.DemandHistoryRepository"/>
    </Match>
    <Match>
        <!--
          TenantDataRepository (21.14) exports, imports and erases every table of a service's own
          schema, so its statements are built per table. Every identifier comes from the database's
          own catalog (information_schema and pg_catalog for current_schema()), is checked by
          TenantDataCatalog to be a plain identifier, and is quoted; the tenant predicates are code
          constants in each service's TenantDataSpec. Nothing a caller sends becomes SQL: table
          names are looked up in the catalog, and row values are bound as one jsonb parameter.
        -->
        <Bug pattern="SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING,SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE"/>
        <Class name="com.storeql.service.TenantDataRepository"/>
        <Method name="aggregateDemand"/>
    </Match>

    <!--
      JDBC PreparedStatement and ResultSet are always closed via try-with-resources in
      this codebase. SpotBugs occasionally misses the try-with-resources pattern when
      the resource is opened inside a lambda or inner class.
    -->
    <Match>
        <Bug pattern="OBL_UNSATISFIED_OBLIGATION_EXCEPTION_EDGE"/>
        <Class name="~.*\.repo\..*"/>
    </Match>

    <!--
      Kafka consumer/producer are closed in @PreDestroy — SpotBugs cannot trace the
      CDI lifecycle so it flags them as potential resource leaks.
    -->
    <Match>
        <Bug pattern="OBL_UNSATISFIED_OBLIGATION,OBL_UNSATISFIED_OBLIGATION_EXCEPTION_EDGE"/>
        <Class name="~.*\.messaging\..*"/>
    </Match>

    <!--
      System.Logger is the JDK's built-in logger (java.lang.System.Logger). SpotBugs
      sometimes flags the static initialisation pattern as a potential issue.
    -->
    <Match>
        <Bug pattern="LG_LOST_LOGGER_DUE_TO_WEAK_REFERENCE"/>
    </Match>

    <!--
      GatewayConfig pre-parses its CSV config properties into Sets once at startup
      (@PostConstruct) and returns the cached field from its accessors. The fields are
      assigned exclusively via Set.copyOf(...), i.e. they hold immutable sets, so
      returning the reference cannot expose mutable internal state. SpotBugs cannot
      prove runtime immutability of a java.util.Set-typed field.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="com.storeql.gateway.GatewayConfig"/>
        <Or>
            <Method name="routableServices"/>
            <Method name="corsAllowedOrigins"/>
        </Or>
    </Match>

    <!--
      Java text blocks (multi-line string literals) are stored with LF (\n) in the
      bytecode constant pool. When the text block is used with String.formatted(),
      SpotBugs 4.8.x fires VA_FORMAT_STRING_USES_NEWLINE, incorrectly treating the
      embedded newlines as platform-dependent escape sequences. HTTP/JSON bodies
      intentionally use LF and do not need %n. This is a SpotBugs false positive for
      text blocks.
    -->
    <Match>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>

</FindBugsFilter>
