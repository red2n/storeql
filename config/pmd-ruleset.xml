<?xml version="1.0"?>
<!--
  PMD ruleset for StoreQL.

  Uses a focused subset of PMD's built-in rules:
    - errorprone  : patterns that are almost always wrong (high signal, low noise)
    - bestpractices: patterns that commonly cause bugs or maintenance problems

  Rules that produce too many CDI/framework false-positives are explicitly excluded.
  Add exclusions with a comment explaining WHY — never exclude silently.
-->
<ruleset name="storeql"
         xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0
                             https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>StoreQL quality ruleset — errorprone + bestpractices, CDI-aware exclusions</description>

    <!-- ── Error-prone patterns ────────────────────────────────────────────── -->
    <rule ref="category/java/errorprone.xml">

        <!-- CDI beans intentionally have no-arg constructors that don't initialise
             injected fields — the container handles that. -->
        <exclude name="BeanMembersShouldSerialize"/>

        <!-- Null checks on @Inject fields are a false positive: CDI guarantees injection. -->
        <exclude name="NullAssignment"/>

        <!-- catch (Exception e) is the standard pattern in our Kafka poll loops
             where we deliberately absorb any error to keep the consumer alive. -->
        <exclude name="AvoidCatchingGenericException"/>

        <!-- We intentionally throw RuntimeException subclasses (ApiException) from
             utility/helper methods — checked exceptions would pollute the call chain. -->
        <exclude name="AvoidThrowingRawExceptionTypes"/>

        <!-- LoggerFactory usage varies by framework; we use System.Logger. -->
        <exclude name="InvalidLogMessageFormat"/>

        <!-- Record-style accessor classes (e.g. BaseEvent) use field name = method name,
             which is idiomatic Java since records. PMD flags it as ambiguous but it is not. -->
        <exclude name="AvoidFieldNameMatchingMethodName"/>

        <!-- Namespace/holder classes (private constructor + only static inner classes) are a valid
             pattern in this codebase (e.g. HealthChecks). PMD requires a static method on such
             classes, but static inner classes are sufficient API surface. -->
        <exclude name="MissingStaticMethodInNonInstantiatableClass"/>

        <!-- JDBC mapper methods (mapBrand, mapProduct, etc.) legitimately repeat column name
             literals such as "id", "tenant_id", "created_at" across multiple methods. Extracting
             these as constants would add noise without improving readability. -->
        <exclude name="AvoidDuplicateLiterals"/>

        <!-- JDBC parameter binders use `ps.setObject(i++, value)` to sequentially bind
             positional parameters. The post-increment inside the method argument is the
             idiomatic and correct pattern for this use case; extracting it as a separate
             statement would obscure the one-parameter-per-call intent. -->
        <exclude name="AssignmentInOperand"/>

        <!-- Service boundary constants (e.g. MAX_SERIALS = 200, DEFAULT_LIMIT = 20) are
             intentionally written as literals near the validation logic they control, so
             readers see the constraint at the point of enforcement rather than searching
             for a constant declaration. These are not "magic numbers" — they are domain
             limits that belong in the method body. -->
        <exclude name="AvoidLiteralsInIfCondition"/>

    </rule>

    <!-- ── Best practices ──────────────────────────────────────────────────── -->
    <rule ref="category/java/bestpractices.xml">

        <!-- JUnit Jupiter test classes and methods do not need to be public. -->
        <exclude name="JUnitTestContainsTooManyAsserts"/>

        <!-- ArchUnit @ArchTest fields are static but assigned in tests via injection —
             PMD wrongly flags them as "should be final". -->
        <exclude name="JUnitTestsShouldIncludeAssert"/>

        <!-- We use System.Logger (JDK built-in) not java.util.logging directly. -->
        <exclude name="GuardLogStatement"/>

        <!-- Abstract classes without abstract methods are used as CDI base beans. -->
        <exclude name="AbstractClassWithoutAbstractMethod"/>

        <!-- Switch expressions with a default clause covering all enum values
             trigger this rule; Java 21 pattern switches are fine. -->
        <exclude name="SwitchStmtsShouldHaveDefault"/>

        <!-- Record compact constructors with inline field assignments trigger this
             rule because PMD 7.x doesn't recognise the compact-constructor assignment as used.
             The rule still fires correctly for normal method bodies. -->
        <exclude name="UnusedAssignment"/>

    </rule>

    <!-- ── StoreQL rules ───────────────────────────────────────────────────── -->
    <rule name="UseTimeOrderedIds"
          language="java"
          message="StoreQL ids are UUIDv7: use Ids.newId(), or Ids.derived(source, name) for a deterministic key"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            UUID.randomUUID() makes version-4 ids and UUID.nameUUIDFromBytes() version-3 ones. StoreQL
            stores only UUIDv7: new rows append at the right-hand edge of a B-tree instead of landing
            on a random page. Use Ids.newId(); for a key that must come out the same every time (a
            dedupe id per event line) use Ids.derived(source, name). A random value that is not an
            id comes from SecureRandom, not from a UUID.
        </description>
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//MethodCall[pmd-java:matchesSig('java.util.UUID#randomUUID()')
           or pmd-java:matchesSig('java.util.UUID#nameUUIDFromBytes(byte[])')]
                ]]></value>
            </property>
        </properties>
    </rule>

    <rule name="ParseIdsAsV7"
          language="java"
          message="Read an id with Ids.parse(text): UUID.fromString takes every version (and '1-1-1-1-1'); StoreQL accepts only a canonical UUIDv7"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            Every id StoreQL holds is an RFC 9562 UUIDv7, so every id it reads — from a request, a
            header, an event, another service's response or a row — is read with Ids.parse(text),
            which refuses any other version, the wrong variant and any non-canonical text.
            UUID.fromString accepts all of those. Building a UUID from bits (new UUID(msb, lsb)) is
            the id module's alone: it is how a version is chosen.
        </description>
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//MethodCall[pmd-java:matchesSig('java.util.UUID#fromString(java.lang.String)')]
    [not(ancestor::CompilationUnit/PackageDeclaration[@Name = 'com.storeql.ids'])]
|
//ConstructorCall[pmd-java:typeIs('java.util.UUID')]
    [not(ancestor::CompilationUnit/PackageDeclaration[@Name = 'com.storeql.ids'])]
                ]]></value>
            </property>
        </properties>
    </rule>

    <rule name="NoDatabaseMintedIds"
          language="java"
          message="Bind Ids.newId() instead of letting SQL make a uuid: gen_random_uuid() and uuid_generate_v4() make version-4 ids"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            SQL that calls gen_random_uuid() or uuid-ossp's uuid_generate_v*() stores ids of another
            version, and neither Ids.newId() nor UseTimeOrderedIds can see it. Put id in the column
            list and bind Ids.newId(). The one set-based insert that cannot (demand_history) calls the
            schema's uuid_v7() function.
        </description>
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//StringLiteral[contains(lower-case(@ConstValue), 'gen_random_uuid')
             or contains(lower-case(@ConstValue), 'uuid_generate_v')]
                ]]></value>
            </property>
        </properties>
    </rule>

    <rule name="ShortRefFromIdTail"
          language="java"
          message="Shorten an id with Ids.shortRef(id), not id.toString().substring(0, n): a v7 id starts with its timestamp"
          class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
        <description>
            The first characters of a UUIDv7 are its millisecond timestamp, so a handle cut from the
            front is the same for every id minted in the same minute: every order placed in it would
            show one order number, every document one batch number. Ids.shortRef(id) takes the random
            tail instead.
        </description>
        <priority>3</priority>
        <properties>
            <property name="xpath">
                <value><![CDATA[
//MethodCall[@MethodName = 'substring']
  [ArgumentList/*[1][self::NumericLiteral and @ValueAsInt = 0]]
  [*[1][self::MethodCall[@MethodName = 'toString'][*[1][pmd-java:typeIs('java.util.UUID')]]]]
                ]]></value>
            </property>
        </properties>
    </rule>

</ruleset>
