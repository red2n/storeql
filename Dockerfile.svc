# Production runtime image for a StoreQL Helidon service.
# Build the whole reactor first (mvn clean install), then build this image per-service:
#   docker build -f Dockerfile.svc --build-arg SVC_PATH=services/sample-svc --build-arg SVC_JAR=sample-svc -t storeql/sample-svc .
# Pinned to 21-jre, and NOT for the reason a bot will assume. The jars target release 21
# (maven.compiler.release), CI builds and tests on 21, and 25 is not a security fix — but the
# blocking reason is that eclipse-temurin:21-jre ships curl and 25-jre does NOT. Every healthcheck in
# docker-compose.yml is `curl -fsS .../health/live`, so on the 25 base every service reports
# unhealthy even though the application starts perfectly, dependents never start, and the whole stack
# fails to come up — which is how the k6 suites are run, so it takes the platform's entire live
# verification with it. (Kubernetes is unaffected: its probes are httpGet and need nothing in the
# image.)
#
# Moving to a newer JRE is a deliberate change, not a version bump: the compose healthchecks have to
# move to something the image actually has in the same commit, and the stack has to be brought up and
# swept afterwards. Dependabot #41 did the bump alone; the application ran on 25.0.4 — Helidon booted,
# Flyway migrated, the probes answered — and the stack still would not start.
FROM eclipse-temurin:24-jre

ARG SVC_PATH
ARG SVC_JAR

LABEL org.opencontainers.image.title="${SVC_JAR}" \
      org.opencontainers.image.description="StoreQL Helidon MP microservice" \
      org.opencontainers.image.source="https://github.com/red2n/home"

# Run as a non-root user (production hardening). The app writes nothing to disk —
# it logs to stdout — so a read-only app dir owned by root is fine.
# A fixed numeric id, so a Kubernetes pod can assert runAsNonRoot and a manifest can name the user.
RUN groupadd -r -g 10001 app && useradd -r -u 10001 -g app -d /app app
WORKDIR /app

# The Helidon jar references libs/ via its manifest Class-Path; copy both.
COPY ${SVC_PATH}/target/${SVC_JAR}.jar /app/app.jar
COPY ${SVC_PATH}/target/libs /app/libs

# In containers, advertise the container hostname to Consul so its health check is reachable on the compose network.
ENV STOREQL_ADVERTISE_HOST=""

USER 10001:10001
EXPOSE 8080
# Container-aware JVM defaults; per-service heap is tuned via JAVA_TOOL_OPTIONS in compose.
ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "-jar", "/app/app.jar"]
