# Production runtime image for a StoreQL Helidon service.
# Build the whole reactor first (mvn clean install), then build this image per-service:
#   docker build -f Dockerfile.svc --build-arg SVC_PATH=services/sample-svc --build-arg SVC_JAR=sample-svc -t storeql/sample-svc .
# Runs on Temurin 25 (the current LTS), pinned to the Ubuntu 24.04 ("noble") variant so the operating
# system never moves under a version bump. The jars still target release 21 (maven.compiler.release), so
# going back to 21 is this one line and nothing else.
#
# The 25 JRE image ships neither curl, wget nor nc. The container healthcheck therefore does not use
# them: infra/healthcheck.sh needs only bash, and docker-compose.yml calls it as
# `healthcheck /health/live`. An 18 Sep 2026 bump changed this line alone, every healthcheck was still
# `curl`, no service ever reported healthy and the whole stack failed to start (Kubernetes was never
# affected: its probes are httpGet). Moving the base is a deliberate change, never a bot's bump: the
# healthcheck moves with it and the stack is brought up and swept afterwards (intent/jdk-25.md).
FROM eclipse-temurin:25-jre-noble

ARG SVC_PATH
ARG SVC_JAR

LABEL org.opencontainers.image.title="${SVC_JAR}" \
      org.opencontainers.image.description="StoreQL Helidon MP microservice" \
      org.opencontainers.image.source="https://github.com/red2n/home"

# Run as a non-root user (production hardening). The app writes nothing to disk —
# it logs to stdout — so a read-only app dir owned by root is fine.
# A fixed numeric id, so a Kubernetes pod can assert runAsNonRoot and a manifest can name the user.
RUN groupadd -r -g 10001 app && useradd -r -u 10001 -g app -d /app app
WORKDIR /app

# The Helidon jar references libs/ via its manifest Class-Path; copy both.
COPY ${SVC_PATH}/target/${SVC_JAR}.jar /app/app.jar
COPY ${SVC_PATH}/target/libs /app/libs

# The container healthcheck (see the note on the base above).
COPY infra/healthcheck.sh /usr/local/bin/healthcheck
RUN chmod 0755 /usr/local/bin/healthcheck

# In containers, advertise the container hostname to Consul so its health check is reachable on the compose network.
ENV STOREQL_ADVERTISE_HOST=""

USER 10001:10001
EXPOSE 8080
# Container-aware JVM defaults; per-service heap is tuned via JAVA_TOOL_OPTIONS in compose.
# --enable-native-access: the JNI libraries on the classpath (Argon2, lz4, Netty) are granted native access
# explicitly, so JDK 24+ does not print a restricted-method warning for each at start-up.
ENTRYPOINT ["java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=75.0", "--enable-native-access=ALL-UNNAMED", "-jar", "/app/app.jar"]
