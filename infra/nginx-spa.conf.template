# Serves the StoreQL Flutter web build as a single-page app (production-grade).
# Runs under the non-root nginx-unprivileged image, which listens on 8080.
#
# A template: the image's entrypoint substitutes ${STOREQL_API_ORIGIN} — the gateway origin the
# bundle was built to call (http://localhost:8090 for a local build; empty when the bundle calls a
# relative /api) — and writes /etc/nginx/conf.d/default.conf. Only variables set in the environment
# are substituted, so nginx's own $variables are left alone.

# One Cache-Control per response, chosen here rather than by add_header in a location. nginx drops
# every server-level add_header inside a location that has an add_header of its own, which is how
# the security headers below never reached a page: index.html, the bundles and every SPA route went
# out with Cache-Control alone (SJ-D60).
#
# Flutter puts no hash in main.dart.js, flutter_bootstrap.js, the canvaskit files or the font assets,
# so nothing here is cached as immutable: everything is revalidated against its ETag and a deploy
# reaches a returning browser on its next load. Marked immutable for a week, a returning browser
# kept running the release before (SJ-D61).
map $uri $storeql_cache_control {
    default                       "no-cache";
    /index.html                   "no-cache, no-store, must-revalidate";
    /flutter_service_worker.js    "no-cache, no-store, must-revalidate";
}

server {
    listen       8080;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # ── Security headers ──────────────────────────────────────────────────────
    # Set here and in no location, so every response carries them (see the map above).
    #
    # Content-Security-Policy (12.11, and SAQ-A's "site not susceptible to script attacks"):
    #   script-src  only this origin; 'wasm-unsafe-eval' lets CanvasKit compile its WebAssembly
    #               and allows no JavaScript eval. index.html carries no inline script.
    #   style-src   'unsafe-inline' because the Flutter engine writes its own style elements.
    #   connect-src this origin, the gateway the bundle calls, and Google's font files, which Flutter
    #               fetches only for glyphs its bundled fonts lack (emoji, Arabic, Urdu).
    #   CanvasKit itself is served from here: the bundle is built with --no-web-resources-cdn.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ${STOREQL_API_ORIGIN} https://fonts.gstatic.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Deprecated, and its filter could itself be abused; OWASP's advice is to switch it off and rely
    # on the CSP.
    add_header X-XSS-Protection "0" always;
    # The till scans barcodes with the camera; nothing else asks for a device.
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
    add_header Cache-Control $storeql_cache_control always;

    # ── Compression ───────────────────────────────────────────────────────────
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json
               application/wasm image/svg+xml font/ttf font/otf font/woff font/woff2;

    # A missing bundle file is a 404, never index.html served as JavaScript.
    location ~* \.(js|mjs|css|png|jpg|jpeg|gif|svg|webp|woff2?|ttf|otf|wasm|json)$ {
        try_files $uri =404;
    }

    # Same-origin API proxy. The Flutter bundle's baked STOREQL_API_BASE can be either
    # a relative "/api" (what CI bakes into the published ghcr.io/red2n/storeql-web
    # image, meant for prod behind one reverse-proxy origin) or an absolute
    # "http://host:port/api" (what a local `flutter build web` bakes for dev, see
    # scripts/redeploy.sh). Absolute URLs bypass this container entirely — the
    # browser calls the gateway host:port directly. This block exists so the
    # relative-URL build also works without a rebuild: it forwards same-origin
    # /api/ calls to the gateway over the compose network.
    location /api/ {
        proxy_pass http://gateway:8080/api/;
        # nginx defaults proxy connections to HTTP/1.0; Helidon's server rejects that
        # with 505 HTTP Version Not Supported. Force 1.1 and drop the hop-by-hop
        # Connection header so keepalive to the upstream works too.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The gateway's own health, for the platform console's Overview. A bundle built with the relative
    # /api asks this origin for /health (gatewayHealthUri drops the /api and adds /health); without
    # this the SPA fallback below answers with index.html, and the Overview can only say the health is
    # not readable here. It reaches the gateway exactly as /api/ does. The gateway answers /health
    # from Helidon's health observer, outside JAX-RS and so outside its token check: public, and the
    # same document the API host already serves. Exactly this path: the probes under it
    # (/health/live, /ready, /started) are for the orchestrator, not the browser.
    location = /health {
        proxy_pass http://gateway:8080/health;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # RFC 9116: the vulnerability disclosure contact. The gateway publishes it from configuration
    # (storeql.gateway.security-txt.*) and answers 404 when a deployment has not configured one, so
    # a stale or invented contact is never served from here.
    location = /.well-known/security.txt {
        proxy_pass http://gateway:8080/.well-known/security.txt;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
    }

    # SPA fallback: unknown paths return index.html so client-side routing works.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Container-internal health probe.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
